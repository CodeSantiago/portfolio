---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroOrbit from '../components/HeroOrbit.astro';
import { SITE } from '../consts';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { cleanSlug, getProjects } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getProjects(lang);
const current = projects.filter((p) => p.data.current);
---

<BaseLayout lang={lang}>
  <div class="home-layout">
    <HeroOrbit />
    <div class="home-main">
      <section class="hero-intro">
        <div class="hero-header">
          <h1 class="hero-name">{SITE.name}</h1>
        </div>

        <div class="hero-code">
          <p class="hero-code-line hero-bio">{t.home.bio}</p>

          {
            current.length > 0 && (
              <p class="hero-code-line hero-currently"><span class="syntax-tag">&lt;output</span><span class="syntax-attribute"> name</span><span class="syntax-punctuation">=</span><span class="syntax-string">"currently"</span><span class="syntax-tag">&gt;</span>{current.map((p, index) => (<span class="hero-current-item">{index > 0 && <span class="syntax-copy">, </span>}<a href={`${localizePath('/projects', lang)}#${cleanSlug(p.id)}`}>{p.data.title}</a></span>))}<span class="syntax-tag">&lt;/output&gt;</span></p>
            )
          }
        </div>

        <div class="social-bar" aria-label={t.home.socialLinks}>
          <a
            href="https://www.linkedin.com/in/santiago-tomas-lopez-54195a26a"
            class="icon-btn"
            target="_blank"
            rel="noreferrer"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
            <span>LinkedIn</span>
          </a>

          <a
            href="https://github.com/CodeSantiago"
            class="icon-btn"
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
            <span>GitHub</span>
          </a>

        </div>
      </section>
    </div>
  </div>
</BaseLayout>
