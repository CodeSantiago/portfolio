---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { getPosts } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<BaseLayout lang={lang} title={t.posts.title} description={t.posts.lead}>
  <header class="page-header">
    <p class="section-kicker">{t.posts.kicker}</p>
    <h1 class="page-title">{t.posts.title}</h1>
    <p class="page-lead">{t.posts.lead}</p>
  </header>

  <section>
    {
      posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => <PostItem post={post} lang={lang} />)}
        </ul>
      ) : (
        <p class="muted">{t.home.notesComingSoon}</p>
      )
    }
  </section>
</BaseLayout>
