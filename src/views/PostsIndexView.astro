---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { getPosts, slugifyTag } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout lang={lang} title={t.posts.title} description={t.posts.lead}>
  <header class="page-header">
    <p class="section-kicker">{t.posts.kicker}</p>
    <h1 class="page-title">{t.posts.title}</h1>
    <p class="page-lead">{t.posts.lead}</p>
  </header>

  {
    tags.length > 0 && (
      <div class="tag-filter-bar">
        <span class="toc-label">{t.posts.topics}</span>
        <ul class="tags tags-lg">
          {tags.map((tag) => (
            <li>
              <a href={localizePath(`/posts/tags/${slugifyTag(tag)}`, lang)}>#{tag}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <section>
    {
      posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => <PostItem post={post} lang={lang} />)}
        </ul>
      ) : (
        <p class="muted">{t.home.notesComingSoon}</p>
      )
    }
  </section>
</BaseLayout>
