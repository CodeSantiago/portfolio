---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { getProjects } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<BaseLayout lang={lang} title={t.projects.title} description={t.projects.lead}>
  <header class="page-header">
    <p class="section-kicker">{t.projects.kicker}</p>
    <h1 class="page-title">{t.projects.title}</h1>
    <p class="page-lead">{t.projects.lead}</p>
  </header>

  <ol class="project-index">
    {projects.map((project, index) => <ProjectRow project={project} index={index} lang={lang} />)}
  </ol>
</BaseLayout>
