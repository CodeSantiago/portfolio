---
import ProjectDetailView from '../../../views/ProjectDetailView.astro';
import { cleanSlug, getProjects } from '../../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects('es');
  return projects.map((project, i) => ({
    params: { slug: cleanSlug(project.id) },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
---

<ProjectDetailView lang="es" project={project} prev={prev} next={next} />
