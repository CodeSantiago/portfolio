---
import Analytics from '@vercel/analytics/astro';

const nav = [
  { href: '#portfolio', label: 'portfolio' },
  { href: '#blog', label: 'blog' },
  { href: '#contact', label: 'contact' },
];

const projects = [
  {
    name: 'Production Agent',
    blurb:
      'Booking businesses lose customers when nobody answers WhatsApp after hours. This assistant schedules, reschedules, and cancels appointments in real time — and has been doing it for ~500 monthly users.',
    year: '2025',
    status: 'in production · ~500 monthly users',
    link: '#',
    repo: '',
    stack: 'Python, FastAPI, Redis, Google Sheets API, Groq LLM API, asyncio, REST APIs, webhooks',
    details:
      'Built for production constraints, not demos: real-time availability, safe rescheduling flows, cancellation handling, and WhatsApp-first interaction for non-technical users.',
    highlights: [
      'Runs in production serving ~500 monthly users over WhatsApp.',
      'Google Sheets as the availability backend, so the business keeps managing its schedule in a tool it already knows.',
      'Redis-backed conversation state with strict flow handling, so the LLM never freestyles with a real booking.',
      'Private repo — client contract prevents public code sharing; architecture and key decisions shown in Schedule Agent repo.',
    ],
  },
  {
    name: 'ArcOps',
    blurb:
      'Cloud engineers lose hours writing CLI commands and API payloads — and one wrong parameter can break infrastructure. A fine-tuned LLM that turns natural language into exact AWS API calls: structured JSON only, no prose, no invented parameters.',
    year: '2026',
    status: 'open source',
    link: 'https://github.com/CodeSantiago/ArcOps',
    repo: 'https://github.com/CodeSantiago/ArcOps',
    stack: 'Python, Qwen2.5-7B, QLoRA 4-bit, HuggingFace Transformers, PEFT, TRL, FastAPI, MCP, LocalStack, Docker',
    details:
      'A Qwen2.5-7B fine-tuned with QLoRA (4-bit) that outputs only the exact JSON for AWS API execution — validated by a safety layer (schema validation, cost estimation, security policies) and running 100% locally against LocalStack or real AWS.',
    highlights: [
      'Fine-tuned on 10,854 curated synthetic examples with noise samples to prevent hallucinations — trained on a single RTX 5070 12GB.',
      '100% tool-selection accuracy, 82.8% field-level precision, 0% hallucinations in production (blocked by the safety layer).',
      'Fully local: no data sent to OpenAI or third parties; the model generalizes to parameter combinations never seen in training.',
      'Integrations: CLI, REST API, MCP server (opencode/Claude/Cursor), TUI dashboard, and Docker for GPU-free deploys.',
    ],
  },
  {
    name: 'Kore Agent',
    blurb:
      'Production Agent proved the model with one business. Kore is the next step: the same agent core, generalized into a multi-tenant platform serving WhatsApp, Telegram, and web from a single codebase.',
    year: '2026',
    status: 'in active development',
    link: '#',
    repo: '#',
    stack: 'Python 3.11, FastAPI, SQLAlchemy, PostgreSQL, Redis, React, Vite, OpenRouter, Docker',
    details:
      'Multi-tenant agent platform for customer-facing support workflows: channel orchestration, conversation memory, and guardrails — evolving a system already validated in production.',
    highlights: [
      'Multi-tenant by design: isolated configuration, channels, and data per client on PostgreSQL + SQLAlchemy.',
      'Provider-agnostic LLM layer through OpenRouter, so model choice is a config decision, not a rewrite.',
      'Grows out of Production Agent rather than a blank slate — the architecture answers problems already seen with real users.',
    ],
  },
  {
    name: 'RAG PetroQuery',
    blurb:
      'Field engineers in Vaca Muerta need instant answers from dense drilling manuals — and a hallucinated pressure rating is not an option. A RAG pipeline that answers with citations, validated numbers, and a full audit trail.',
    year: '2026',
    status: 'technical demo',
    link: '#',
    repo: 'https://github.com/CodeSantiago/petroquery',
    stack: 'FastAPI, SQLAlchemy 2.0 (async), Pydantic, Instructor, Next.js, PostgreSQL 16 + pgvector, Groq, multilingual-e5-large, Docker, pytest',
    details:
      'Built to prove that RAG for safety-critical industry is not a chatbot with a vector store: a six-stage typed pipeline — classification, hybrid retrieval, reranking, schema-enforced generation, numeric validation, and safety overlays.',
    highlights: [
      'Numeric validation cross-checks every figure against retrieved chunks — the system abstains rather than inventing a spec.',
      '4-level traceability (document → page → section → table/figure), as required by Argentine IAPG regulations.',
      'Hybrid retrieval: e5-large vectors + PostgreSQL FTS fused with RRF, then cross-encoder reranking — built for Spanish prose mixed with English acronyms (BOP, H2S, PPE).',
      'Structured generation via Instructor + Pydantic: the LLM cannot return malformed output.',
    ],
  },
  {
    name: 'AeroScan-ESG',
    blurb:
      'Satellite methane monitoring over the Neuquina basin (Neuquén, Río Negro, Mendoza, La Pampa) using Sentinel-5P data — anomaly detection with configurable sensitivity for ESG compliance.',
    year: '2026',
    status: 'technical demo',
    link: 'https://aero-scan-esg.vercel.app',
    repo: 'https://github.com/CodeSantiago/AeroScan-ESG',
    stack: 'FastAPI, React, Vite, Leaflet, SQLite, Sentinel-5P CH4 (Copernicus)',
    details:
      'A full-stack geospatial dashboard for methane leak detection from satellite data. Ingests daily Sentinel-5P CH4 files, computes anomaly thresholds (1σ/2σ/3σ), and renders an interactive map with alert zones and 7-day trend charts.',
    highlights: [
      'Real satellite data pipeline: automated Sentinel-5P download, NetCDF parsing, and daily methane column storage in SQLite.',
      'Configurable sensitivity via sigma slider — users tune false-positive vs false-negative tradeoff for their compliance threshold.',
      'Interactive map with vector/satellite basemaps, color-coded alert zones (yellow/orange/red), and CSV/PDF report export.',
      'Deployed on Vercel (frontend) + Render (backend API) — real production deployment for a technical demo.',
    ],
  },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="AI engineer building agents, retrieval systems, and internal tools that move from prototype to production — one already serving ~500 monthly users." />
    <title>Santiago Lopez — AI Engineer</title>
    <Analytics />
  </head>
  <body>
    <header class="topbar">
      <a href="#top" class="brand">CodeSantiago</a>
      <nav>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <h1>
          <span id="name-trigger" class="name-trigger" role="button" tabindex="0" aria-label="Trigger name easter egg">
            Santiago Lopez
          </span>
        </h1>
        <p class="tagline">AI engineer building agents, retrieval systems, and internal tools that move from prototype to production — one already serving ~500 monthly users in production.</p>
        <ul class="signal-list">
          <li>agents with tools, memory, and guardrails</li>
          <li>retrieval and knowledge systems for real teams</li>
          <li>product engineering with strong technical taste</li>
        </ul>
        <p class="meta">available for high-leverage ai engineering work.</p>
      </section>

      <section>
        <h2 id="portfolio">/portfolio</h2>
        <p class="section-intro">
          Selected work across applied AI, backend systems, and product delivery.
          The common thread is simple: useful software, shipped with constraints in mind.
        </p>
        <ul class="projects">
          {projects.map((p, index) => (
            <li>
              <div class="project-heading">
                <div>
                  <a class="project-name" href={p.link}>{p.name}/</a>
                  <span class="project-year">{p.year}</span>
                  <span class="project-status">{p.status}</span>
                </div>
                <button
                  class="project-info-trigger"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`project-details-${index}`}
                  data-project-trigger
                >
                  ···
                  <span class="sr-only">Show more about {p.name}</span>
                </button>
              </div>
              <p class="project-blurb">{p.blurb}</p>
              <p class="project-stack">{p.stack}</p>
<div class="project-details" id={`project-details-${index}`} hidden>
                <p>{p.details}</p>
                <ul class="project-highlights">
                  {p.highlights.map((h) => <li>{h}</li>)}
                </ul>
                {p.repo && <a class="project-link" href={p.repo}>code →</a>}
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 id="blog">/blog</h2>
        <p class="section-intro">
          Notes on AI systems, engineering judgment, product tradeoffs, and what breaks once real users show up.
        </p>
        <p class="empty-state">Notes coming soon.</p>
      </section>

      <section>
        <h2 id="contact">/contact</h2>
        <p class="section-intro">
          If you are building something ambitious in AI and need an engineer who can move between model behavior, systems design, and shipped product, reach out.
        </p>
        <ul class="contact">
          <li>email &mdash; <a href="mailto:contacto.ssnt@gmail.com">contacto.ssnt@gmail.com</a></li>
          <li>github &mdash; <a href="https://github.com/CodeSantiago">github.com/CodeSantiago</a></li>
          <li>linkedin &mdash; <a href="https://www.linkedin.com/in/santiago-tomas-lopez-54195a26a">linkedin.com/in/codesantiago</a></li>
        </ul>
        <p class="footer">
          <span>&copy; 2026</span>
          <span class="dot">&middot;</span>
          <span>built with astro</span>
          <span class="dot">&middot;</span>
          <span>last updated 2026-07-22</span>
        </p>
      </section>
    </main>
    <script>
      const trigger = document.querySelector('#name-trigger');

      if (trigger instanceof HTMLElement) {
        let active = false;

        const play = () => {
          if (active) return;
          active = true;
          trigger.classList.remove('is-shining');
          window.requestAnimationFrame(() => {
            trigger.classList.add('is-shining');
          });

          window.setTimeout(() => {
            trigger.classList.remove('is-shining');
            active = false;
          }, 900);
        };

        trigger.addEventListener('click', play);
        trigger.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            play();
          }
        });
      }

      const projectTriggers = document.querySelectorAll('[data-project-trigger]');

      projectTriggers.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;

        button.addEventListener('click', () => {
          const detailsId = button.getAttribute('aria-controls');
          if (!detailsId) return;

          const details = document.getElementById(detailsId);
          if (!(details instanceof HTMLElement)) return;

          const isOpen = button.getAttribute('aria-expanded') === 'true';
          button.setAttribute('aria-expanded', String(!isOpen));
          button.classList.toggle('is-open', !isOpen);
          button.firstChild?.replaceWith(!isOpen ? '—' : '···');
          details.hidden = isOpen;
        });
      });
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #000000;
    --fg: #d6d6d6;
    --muted: #6a6a6a;
    --dim: #3a3a3a;
    --accent: #e0e0e0;
    --link: #b8b8b8;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
      "Liberation Mono", monospace;
    font-size: 15px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--link);
    text-decoration: none;
    border-bottom: 1px dotted var(--dim);
  }

  a:hover {
    color: var(--accent);
    border-bottom-color: var(--fg);
  }

  /* layout */
  main {
    max-width: 920px;
    margin: 0 auto;
    padding: 64px 24px 96px;
  }

  section {
    margin-top: 88px;
  }

  /* topbar */
  .topbar {
    max-width: 920px;
    margin: 0 auto;
    padding: 24px 24px 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .brand {
    color: var(--fg);
    border-bottom: none;
  }

  .topbar nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 20px;
  }

  .topbar nav a {
    border-bottom: none;
  }

  /* hero */
  .hero h1 {
    font-size: 44px;
    font-weight: 500;
    line-height: 1.15;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
    max-width: 13ch;
  }

  .name-trigger {
    color: inherit;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    display: inline-block;
    text-align: left;
    white-space: nowrap;
  }

  .name-trigger:hover,
  .name-trigger:focus-visible {
    color: var(--accent);
    outline: none;
  }

  .name-trigger.is-shining {
    animation: subtle-name-shine 820ms ease-out forwards;
  }

  @keyframes subtle-name-shine {
    0% {
      color: var(--fg);
      text-shadow: none;
    }

    35% {
      color: #ffffff;
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.18);
    }

    100% {
      color: var(--fg);
      text-shadow: none;
    }
  }

  .eyebrow {
    color: var(--muted);
    margin: 0 0 22px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: lowercase;
  }

  .tagline {
    color: var(--muted);
    margin: 0 0 24px;
    max-width: 62ch;
  }

  .meta {
    color: var(--muted);
    margin: 0;
    font-size: 14px;
  }

  .signal-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }

  .signal-list li {
    color: var(--fg);
    padding: 4px 0;
  }

  .signal-list li::before {
    content: '- ';
    color: var(--dim);
  }

  .dot {
    margin: 0 8px;
    color: var(--dim);
  }

  /* section heads */
  h2 {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 24px;
    letter-spacing: 0.02em;
  }

  .section-intro {
    margin: 0 0 22px;
    color: var(--muted);
    max-width: 62ch;
  }

  /* projects */
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .projects li {
    padding: 18px 0;
    border-top: 1px solid var(--dim);
  }

  .projects li:last-child {
    border-bottom: 1px solid var(--dim);
  }

  .project-name {
    color: var(--fg);
    border-bottom: none;
  }

  .project-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .project-info-trigger {
    min-width: 32px;
    height: 24px;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 16px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .project-info-trigger:hover,
  .project-info-trigger:focus-visible,
  .project-info-trigger.is-open {
    color: var(--fg);
    outline: none;
  }

  .project-year {
    color: var(--muted);
    margin-left: 12px;
    font-size: 13px;
  }

  .project-status {
    display: block;
    color: var(--muted);
    font-size: 13px;
    margin-top: 2px;
  }

  .project-blurb {
    margin: 6px 0 0;
    color: var(--muted);
    max-width: 60ch;
  }

  .project-stack {
    margin: 8px 0 0;
    color: var(--dim);
    max-width: 60ch;
    font-size: 13px;
  }

.project-details {
    margin-top: 16px;
    padding: 16px;
    border: 1px solid var(--dim);
    background: rgba(255, 255, 255, 0.02);
  }

  .project-details[hidden] {
    display: none;
  }

  .project-details p {
    margin: 0;
    color: var(--fg);
  }

  .project-highlights {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
  }

  .project-highlights li {
    color: var(--fg);
    padding: 4px 0;
  }

  .project-highlights li::before {
    content: '- ';
    color: var(--dim);
  }

  .project-link {
    display: inline-block;
    margin-top: 16px;
    color: var(--link);
    border-bottom: 1px dotted var(--dim);
  }

  .project-link:hover {
    color: var(--accent);
    border-bottom-color: var(--fg);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .empty-state {
    color: var(--muted);
    margin: 0;
  }

  /* contact */
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact li {
    padding: 6px 0;
  }

  .footer {
    margin-top: 72px;
    color: var(--dim);
    font-size: 13px;
  }

@media (max-width: 720px) {
    main {
      padding-top: 48px;
    }

    section {
      margin-top: 72px;
    }

    .topbar {
      padding-top: 20px;
    }

    .topbar nav ul {
      gap: 14px;
    }

    .hero h1 {
      font-size: 34px;
    }
  }
</style>
