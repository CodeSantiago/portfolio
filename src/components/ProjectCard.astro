---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, localizePath, useTranslations, type Lang } from '../i18n/ui';
import { cleanSlug } from '../lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  lang?: Lang;
}

const { project, index = 0 } = Astro.props;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, summary, details, highlights, year, status, statusNote, stack, repo, demo, metrics } =
  project.data;
const normalize = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
const showStatusNote = statusNote
  ? !normalize(statusNote).startsWith(normalize(t.status[status]))
  : false;
const slug = cleanSlug(project.id);
const num = String(index + 1).padStart(2, '0');
const projectPath = localizePath(`/projects/${slug}`, lang);
---

<details class="project-entry" id={slug} data-status={status}>
  <summary class="project-entry-summary">
    <span class="project-entry-num" aria-hidden="true">{num}</span>
    <span class="project-entry-meta">
      <span>{year}</span>
      <span class="project-entry-status">
        <span class="status-indicator" aria-hidden="true"></span>
        {t.status[status]}
        {showStatusNote && statusNote && <span class="status-note">· {statusNote}</span>}
      </span>
    </span>
    <span class="project-entry-title" role="heading" aria-level="2">{title}</span>
    <span class="project-entry-description">{summary}</span>
    <span class="project-entry-toggle" aria-hidden="true">+</span>
  </summary>

  <div class="project-entry-content">
    {
      details && (
        <section class="project-entry-section">
          <h3 class="project-entry-label">{t.projects.architectureLabel}</h3>
          <p>{details}</p>
        </section>
      )
    }

    {
      highlights.length > 0 && (
        <section class="project-entry-section">
          <h3 class="project-entry-label">{t.projects.highlightsLabel}</h3>
          <ul class="project-entry-highlights">
            {highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </section>
      )
    }

    {
      metrics.length > 0 && (
        <ul class="project-entry-metrics" aria-label={t.projects.metricsLabel}>
          {metrics.map((metric) => (
            <li>
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      stack.length > 0 && (
        <p class="project-entry-stack">
          <span class="project-entry-stack-label">{t.projects.stackLabel}</span>
          {stack.join(' · ')}
        </p>
      )
    }

    <div class="project-entry-actions">
      <a class="project-entry-case" href={projectPath}>{t.projects.caseStudy} →</a>
      {repo && (
        <a href={repo} target="_blank" rel="noreferrer">
          {t.projects.codeShort} ↗
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noreferrer">
          {t.projects.demoShort} ↗
        </a>
      )}
      {!repo && status === 'production' && (
        <span class="project-entry-private">{t.projects.privateRepo}</span>
      )}
    </div>
  </div>
</details>
